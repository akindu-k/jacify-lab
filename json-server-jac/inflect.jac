glob P_MEN: re.Pattern = re.compile(r"^(m|wom)en\Z", re.IGNORECASE),
     P_PEOPLE: re.Pattern = re.compile(r"(pe)ople\Z", re.IGNORECASE),
     P_CHILDREN: re.Pattern = re.compile(r"(child)ren\Z", re.IGNORECASE),
     P_TIA: re.Pattern = re.compile(r"([ti])a\Z", re.IGNORECASE),
     P_ANALYSES: re.Pattern = re.compile(
         r"((a)naly|(b)a|(d)iagno|(p)arenthe|(p)rogno|(s)ynop|(t)he)ses\Z", re.IGNORECASE
     ),
     P_DATABASES: re.Pattern = re.compile(r"(database)s\Z", re.IGNORECASE),
     P_DRIVES: re.Pattern = re.compile(r"(drive)s\Z", re.IGNORECASE),
     P_HIVES: re.Pattern = re.compile(r"(hi|ti)ves\Z", re.IGNORECASE),
     P_CURVES: re.Pattern = re.compile(r"(curve)s\Z", re.IGNORECASE),
     P_LRVES: re.Pattern = re.compile(r"([lr])ves\Z", re.IGNORECASE),
     P_AVES: re.Pattern = re.compile(r"([a])ves\Z", re.IGNORECASE),
     P_FOVES: re.Pattern = re.compile(r"([^fo])ves\Z", re.IGNORECASE),
     P_MOVIES: re.Pattern = re.compile(r"(m)ovies\Z", re.IGNORECASE),
     P_AEIOUYIES: re.Pattern = re.compile(r"([^aeiouy]|qu)ies\Z", re.IGNORECASE),
     P_SERIES: re.Pattern = re.compile(r"(s)eries\Z", re.IGNORECASE),
     P_XES: re.Pattern = re.compile(r"(x|ch|ss|sh)es\Z", re.IGNORECASE),
     P_MICE: re.Pattern = re.compile(r"([m|l])ice\Z", re.IGNORECASE),
     P_BUSES: re.Pattern = re.compile(r"(bus)es\Z", re.IGNORECASE),
     P_OES: re.Pattern = re.compile(r"(o)es\Z", re.IGNORECASE),
     P_SHOES: re.Pattern = re.compile(r"(shoe)s\Z", re.IGNORECASE),
     P_CRISES: re.Pattern = re.compile(r"(cris|ax|test)es\Z", re.IGNORECASE),
     P_OCTOPUSES: re.Pattern = re.compile(r"(octop|vir)uses\Z", re.IGNORECASE),
     P_ALIASES: re.Pattern = re.compile(r"(alias|canvas|status|campus)es\Z", re.IGNORECASE),
     P_SUMMONSES: re.Pattern = re.compile(r"^(summons|bonus)es\Z", re.IGNORECASE),
     P_OXEN: re.Pattern = re.compile(r"^(ox)en", re.IGNORECASE),
     P_MATRICES: re.Pattern = re.compile(r"(matr)ices\Z", re.IGNORECASE),
     P_VERTICES: re.Pattern = re.compile(r"(vert|ind)ices\Z", re.IGNORECASE),
     P_FEET: re.Pattern = re.compile(r"^feet\Z", re.IGNORECASE),
     P_TEETH: re.Pattern = re.compile(r"^teeth\Z", re.IGNORECASE),
     P_GEESE: re.Pattern = re.compile(r"^geese\Z", re.IGNORECASE),
     P_QUIZZES: re.Pattern = re.compile(r"(quiz)zes\Z", re.IGNORECASE),
     P_WHEREASES: re.Pattern = re.compile(r"^(whereas)es\Z", re.IGNORECASE),
     P_CRITERIA: re.Pattern = re.compile(r"^(criteri)a\Z", re.IGNORECASE),
     P_GENERA: re.Pattern = re.compile(r"^genera\Z", re.IGNORECASE),
     P_SS: re.Pattern = re.compile(r"ss\Z", re.IGNORECASE),
     P_S: re.Pattern = re.compile(r"s\Z", re.IGNORECASE);

glob S_MAN: re.Pattern = re.compile(r"^(m|wom)an\Z", re.IGNORECASE),
     S_PERSON: re.Pattern = re.compile(r"(pe)rson\Z", re.IGNORECASE),
     S_CHILD: re.Pattern = re.compile(r"(child)\Z", re.IGNORECASE),
     S_DRIVE: re.Pattern = re.compile(r"(drive)\Z", re.IGNORECASE),
     S_OX: re.Pattern = re.compile(r"^(ox)\Z", re.IGNORECASE),
     S_AXIS: re.Pattern = re.compile(r"(ax|test)is\Z", re.IGNORECASE),
     S_OCTOPUS: re.Pattern = re.compile(r"(octop|vir)us\Z", re.IGNORECASE),
     S_ALIAS: re.Pattern = re.compile(r"(alias|status|canvas|campus)\Z", re.IGNORECASE),
     S_SUMMONS: re.Pattern = re.compile(r"^(summons|bonus)\Z", re.IGNORECASE),
     S_BUS: re.Pattern = re.compile(r"(bu)s\Z", re.IGNORECASE),
     S_BUFFALO: re.Pattern = re.compile(r"(buffal|tomat|potat)o\Z", re.IGNORECASE),
     S_TIUM: re.Pattern = re.compile(r"([ti])um\Z", re.IGNORECASE),
     S_SIS: re.Pattern = re.compile(r"sis\Z", re.IGNORECASE),
     S_FFE: re.Pattern = re.compile(r"(?:([^f])fe|([lr])f)\Z", re.IGNORECASE),
     S_FOCUS: re.Pattern = re.compile(r"^(focus)\Z", re.IGNORECASE),
     S_HIVE: re.Pattern = re.compile(r"(hi|ti)ve\Z", re.IGNORECASE),
     S_AEIOUYY: re.Pattern = re.compile(r"([^aeiouy]|qu)y\Z", re.IGNORECASE),
     S_X: re.Pattern = re.compile(r"(x|ch|ss|sh)\Z", re.IGNORECASE),
     S_MATRIX: re.Pattern = re.compile(r"(matr)ix\Z", re.IGNORECASE),
     S_VERTEX: re.Pattern = re.compile(r"(vert|ind)ex\Z", re.IGNORECASE),
     S_MOUSE: re.Pattern = re.compile(r"([m|l])ouse\Z", re.IGNORECASE),
     S_FOOT: re.Pattern = re.compile(r"^foot\Z", re.IGNORECASE),
     S_TOOTH: re.Pattern = re.compile(r"^tooth\Z", re.IGNORECASE),
     S_GOOSE: re.Pattern = re.compile(r"^goose\Z", re.IGNORECASE),
     S_QUIZ: re.Pattern = re.compile(r"(quiz)\Z", re.IGNORECASE),
     S_WHEREAS: re.Pattern = re.compile(r"^(whereas)\Z", re.IGNORECASE),
     S_CRITERION: re.Pattern = re.compile(r"^(criteri)on\Z", re.IGNORECASE),
     S_GENUS: re.Pattern = re.compile(r"^genus\Z", re.IGNORECASE),
     S_S: re.Pattern = re.compile(r"s\Z", re.IGNORECASE),
     S_COMMON: re.Pattern = re.compile(r"\Z", re.IGNORECASE);

def plural_rules -> list[Rule];

def singular_rules -> list[Rule];

def apply_rules(word: str, rules: list[Rule]) -> str;

def pluralize(word: str) -> str;

def singularize(word: str) -> str;

glob PLURAL_RULES: list[Rule] = plural_rules();

glob SINGULAR_RULES: list[Rule] = singular_rules();
